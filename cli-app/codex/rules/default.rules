prefix_rule(
    pattern = ["git", "fetch"],
    decision = "allow",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow creating commits from any repository",
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
)

prefix_rule(
    pattern = [
        "git",
        "-c",
        [
            "user.name=GPT-5.6 Sol - Codex",
            "user.name=GPT-5.6 Terra - Codex",
            "user.name=GPT-5.6 Luna - Codex",
        ],
        "-c",
        "user.email=292837902+arapacati[bot]@users.noreply.github.com",
        "commit",
    ],
    decision = "allow",
    justification = "Allow GPT-5.6 Codex models to create commits",
)
prefix_rule(pattern=["ssh", "nahida"], decision="allow")
prefix_rule(pattern=["docker", "compose", "up"], decision="allow")
prefix_rule(pattern=["git", "status", "--short"], decision="allow")
prefix_rule(pattern=["docker", "image", "inspect", "kazu:latest", "--format", "{{.Id}}"], decision="allow")
prefix_rule(pattern=["task", "up"], decision="allow")
